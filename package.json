{
  "name": "beanlog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && npm run build:cli",
    "build:cli": "esbuild scripts/user-create.ts scripts/user-password.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outdir=build/cli --log-level=warning",
    "start": "node server.js",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "user:create": "tsx scripts/user-create.ts",
    "user:password": "tsx scripts/user-password.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@react-router/express": "^8.5.0",
    "@react-router/node": "^8.5.0",
    "compression": "^1.8.2",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "isbot": "^5.1.36",
    "morgan": "^1.12.1",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}